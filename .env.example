# ==============================================================================
# VANGUARD - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development or set in production hosting
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (MongoDB)
# ------------------------------------------------------------------------------
# Required: Connection string for MongoDB (e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_ID>.mongodb.net/vanguard?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (NextAuth.js v4)
# ------------------------------------------------------------------------------
# Required: Full canonical URL of your site (e.g., https://vanguard.news or http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000

# Required in production: A strong random secret for JWT encryption and session signing
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-strong-random-32-byte-secret-for-production

# ------------------------------------------------------------------------------
# 3. INITIAL ADMIN ACCOUNT BOOTSTRAP (Optional)
# ------------------------------------------------------------------------------
# If set, this admin user is automatically created upon first login attempt if it does not exist
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-strong-admin-password

# ------------------------------------------------------------------------------
# 4. CLOUDINARY (Media Storage)
# ------------------------------------------------------------------------------
# Required for feature image uploads in the newsroom editor
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
