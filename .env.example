# ------------------------------------------------------------------------------
# 1. DATABASE (MongoDB)
# ------------------------------------------------------------------------------
# Required: Connection string for MongoDB (e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://mediaunmochon_db_user:aFxaVgyXZuVmP9jO@cluster0.mongodb.net/vanguard?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (NextAuth.js v4)
# ------------------------------------------------------------------------------
# Required: Full canonical URL of your site (e.g., https://vanguard.news or http://localhost:3000)
